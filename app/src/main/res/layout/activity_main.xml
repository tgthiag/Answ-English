<?xml version="1.0" encoding="utf-8"?>
<layout>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_surface"
    tools:context="AnsweringAPP.activities.MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toTopOf="@id/adView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btShare"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp"
                    android:text="@string/share"
                    android:textAllCaps="false"
                    android:textColor="@color/home_toolbar_button_text"
                    app:backgroundTint="@color/home_toolbar_button_bg"
                    app:cornerRadius="999dp"
                    app:icon="@drawable/share"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/home_toolbar_button_icon"
                    app:strokeColor="@color/home_card_stroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btSettings"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp"
                    android:text="@string/configuration"
                    android:textAllCaps="false"
                    android:textColor="@color/home_toolbar_button_text"
                    app:backgroundTint="@color/home_toolbar_button_bg"
                    app:cornerRadius="999dp"
                    app:icon="@drawable/config"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/home_toolbar_button_icon"
                    app:strokeColor="@color/home_card_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp"
                app:cardUseCompatPadding="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_card"
                    android:padding="24dp">

                    <!-- Guideline: gives a percent-based split between text (left) and image (right) -->
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline_vertical_70"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.70" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/hero_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="false"
                        android:clickable="false"
                        android:text="@string/home_chip_text"
                        android:textColor="@color/home_chip_text"
                        app:chipBackgroundColor="@color/home_chip_background"
                        app:chipCornerRadius="999dp"
                        app:chipIcon="@drawable/ic_notification"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/home_chip_text"
                        app:chipStartPadding="12dp"
                        app:chipStrokeColor="@color/home_chip_stroke"
                        app:chipStrokeWidth="1dp"
                        app:chipEndPadding="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/appTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/app_name"
                        android:textColor="@color/home_text_primary"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintEnd_toStartOf="@id/guideline_vertical_70"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/hero_chip" />

                    <TextView
                        android:id="@+id/appSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/subtitle"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="16sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintEnd_toStartOf="@id/guideline_vertical_70"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/appTitle" />

                    <TextView
                        android:id="@+id/heroDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/home_hero_description"
                        android:textColor="@color/home_text_primary"
                        android:textSize="14sp"
                        android:alpha="0.9"
                        android:maxLines="6"
                        android:ellipsize="end"
                        app:layout_constraintEnd_toStartOf="@id/guideline_vertical_70"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/appSubtitle"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/logo"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@string/a_guy_sitting_in_a_big_interrogation_mark"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:src="@drawable/logo"
                        app:layout_constraintStart_toEndOf="@id/guideline_vertical_70"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintWidth_percent="0.30"
                        app:layout_constraintDimensionRatio="1:1" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/levelsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/choose_your_level"
                android:textColor="@color/home_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/levelsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/home_levels_subtitle"
                android:textColor="@color/home_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bt_aboutYou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/home_card_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/home_card_stroke"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <View
                        android:id="@+id/basicAccent"
                        android:layout_width="6dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_accent_pill"
                        android:backgroundTint="@color/level_basic"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/basicTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/firstLevel"
                        android:textColor="@color/home_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/basicArrow"
                        app:layout_constraintStart_toEndOf="@id/basicAccent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/basicDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/basic_level_description"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/basicArrow"
                        app:layout_constraintStart_toEndOf="@id/basicAccent"
                        app:layout_constraintTop_toBottomOf="@id/basicTitle" />

                    <ImageView
                        android:id="@+id/basicArrow"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/basic_level_description"
                        android:padding="4dp"
                        android:src="@drawable/ic_arrow_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bt_everyDayThings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/home_card_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/home_card_stroke"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <View
                        android:id="@+id/interAccent"
                        android:layout_width="6dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_accent_pill"
                        android:backgroundTint="@color/level_intermediate"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/interTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/secondLevel"
                        android:textColor="@color/home_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/interArrow"
                        app:layout_constraintStart_toEndOf="@id/interAccent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/interDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/intermediate_level_description"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/interArrow"
                        app:layout_constraintStart_toEndOf="@id/interAccent"
                        app:layout_constraintTop_toBottomOf="@id/interTitle" />

                    <ImageView
                        android:id="@+id/interArrow"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/intermediate_level_description"
                        android:padding="4dp"
                        android:src="@drawable/ic_arrow_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bt_jobInterview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/home_card_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/home_card_stroke"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <View
                        android:id="@+id/advancedAccent"
                        android:layout_width="6dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_accent_pill"
                        android:backgroundTint="@color/level_advanced"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/advancedTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/thirdLevel"
                        android:textColor="@color/home_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/advancedArrow"
                        app:layout_constraintStart_toEndOf="@id/advancedAccent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/advancedDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/advanced_level_description"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/advancedArrow"
                        app:layout_constraintStart_toEndOf="@id/advancedAccent"
                        app:layout_constraintTop_toBottomOf="@id/advancedTitle" />

                    <ImageView
                        android:id="@+id/advancedArrow"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/advanced_level_description"
                        android:padding="4dp"
                        android:src="@drawable/ic_arrow_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/allQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/home_card_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/home_card_stroke"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <View
                        android:id="@+id/randomAccent"
                        android:layout_width="6dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_accent_pill"
                        android:backgroundTint="@color/level_random"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/randomTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/allLevels"
                        android:textColor="@color/home_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/randomArrow"
                        app:layout_constraintStart_toEndOf="@id/randomAccent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/randomDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/random_level_description"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/randomArrow"
                        app:layout_constraintStart_toEndOf="@id/randomAccent"
                        app:layout_constraintTop_toBottomOf="@id/randomTitle" />

                    <ImageView
                        android:id="@+id/randomArrow"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/random_level_description"
                        android:padding="4dp"
                        android:src="@drawable/ic_arrow_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:adSize="SMART_BANNER"
        app:adUnitId="ca-app-pub-2884509228034182/8623568236"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
